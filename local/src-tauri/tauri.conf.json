{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SplitLens",
  "version": "0.1.0",
  "identifier": "app.splitlens.local",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:3000",
    "frontendDist": "../out"
  },
  "app": {
    "windows": [
      {
        "title": "SplitLens",
        "width": 1280,
        "height": 850,
        "minWidth": 960,
        "minHeight": 650
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Finance"
  }
}
